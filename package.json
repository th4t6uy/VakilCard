{
  "name": "vakilcard",
  "version": "1.0.0",
  "private": true,
  "description": "VakilCard — standalone digital chamber card product, extracted from Apps/Vakilpedia-website. Consumes SupraCore services where available; currently self-contained pending that integration.",
  "dependencies": {
    "firebase": "^10.9.0",
    "lucide-react": "^0.507.0",
    "qrcode-generator": "^1.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.5.1",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "craco start",
    "prestart": "node scripts/build-vakilcard-ds.cjs",
    "prebuild": "node scripts/build-vakilcard-ds.cjs",
    "build": "DISABLE_ESLINT_PLUGIN=true CI=false craco build",
    "dev:api": "node scripts/dev-api-server.cjs",
    "test": "node tests/vakilcard-verification.test.js && node tests/vakilcard-entitlements.test.js && node tests/vakilcard-onboarding.test.js && node tests/vakilcard-upload.test.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@craco/craco": "^7.1.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7"
  }
}
