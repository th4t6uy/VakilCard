# VakilCard environment variables — same values as Apps/Vakilpedia-website
# uses today (this app is not yet independently deployed; see README.md).

# --- API (api/vakilcard/*.js) ---
SUPABASE_URL=                       # optional, defaults to the project URL
SUPABASE_SERVICE_ROLE_KEY=          # required — all DB access (RLS deny-all, service-role only)
VAKILPEDIA_AUTH_SECRET=             # required — signs session JWTs + HMACs verification codes
WA_PHONE_ID=                        # Meta WhatsApp Business API (same values as the Render backend)
WA_TOKEN=
VERIFICATION_PROVIDER=whatsapp      # "whatsapp" (default) or "console" (dev: codes to logs only)
VAKILCARD_ADMIN_PHONES=             # comma-separated phone numbers with admin.js access
VAKILCARD_BILLING_SECRET=           # secret-authed billing webhook/admin "activate" action (subscription.js)
VAKILCARD_FOUNDER_OPEN=1            # "0" closes the founder-pricing window; open by default in beta
VAKILCARD_SITE_URL=                 # public origin used in generated links (vCard, share, etc.)

# --- Frontend (build-time, CRA convention: must be prefixed REACT_APP_) ---
REACT_APP_VAKILCARD_QA_HOST=          # optional — dev-only QA bypass hostname (see src/lib/vakilcardQa.js); localhost/127.0.0.1/0.0.0.0 always work without this
