{
  "version": 2,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/nfc/:code([a-z0-9]{6,16})", "destination": "/api/vakilcard/nfc?code=:code" },
    { "source": "/vakilcard", "destination": "/index.html" },
    { "source": "/vakilcard/:path*", "destination": "/index.html" },
    { "source": "/:username([a-zA-Z0-9][a-zA-Z0-9._-]{2,29})", "destination": "/api/vakilcard/profile?username=:username" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
